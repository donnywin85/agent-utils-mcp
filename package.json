{
  "name": "agent-utils-mcp",
  "mcpName": "com.donnyautomation/geocode-weather-search-markdown",
  "version": "0.1.0",
  "description": "MCP server exposing eight paid agent utilities — forward/reverse geocoding, weather forecast, web search, URL-to-Markdown, cryptographic randomness, OFAC sanctions screening and GLEIF LEI lookup — paid per call in USDC on Base ($0.003 utilities, $0.03 compliance) via x402. The buyer's wallet key comes from the installing user's own env; no keys are bundled.",
  "type": "module",
  "bin": {
    "agent-utils-mcp": "src/index.mjs"
  },
  "files": [
    "src/",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "selftest": "node test/live-call-test.mjs",
    "listtools": "node test/list-tools-test.mjs",
    "pricecheck": "node test/price-drift-test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "geocode",
    "geocoding",
    "weather",
    "forecast",
    "web-search",
    "search",
    "markdown",
    "readability",
    "agent",
    "usdc",
    "base",
    "pay-per-call",
    "sanctions",
    "ofac",
    "compliance",
    "kyc",
    "screening",
    "lei",
    "gleif"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donnywin85/agent-utils-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
