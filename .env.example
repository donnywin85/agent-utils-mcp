# Copy to .env for local runs, or set these in your MCP client's server config.
# NEVER commit a real key. .env and .env.* are gitignored.

# REQUIRED. Base-mainnet buyer wallet private key (0x-prefixed).
#
#   - Fund it with a few dollars of USDC on Base.
#   - It needs ZERO ETH: payments use EIP-3009 transferWithAuthorization and the
#     x402 facilitator broadcasts and pays the gas.
#   - USE A LOW-BALANCE DISPOSABLE WALLET. This key sits in your MCP client
#     config in plaintext, and any process that can read that config can spend
#     from it. Do not reuse a wallet that holds anything you care about.
EVM_PRIVATE_KEY=0xyour_disposable_base_wallet_private_key

# OPTIONAL. Override the gateway base URL. Defaults to the public one below.
# GATEWAY_URL=https://x402.donnyautomation.com
